<?xml version="1.0" encoding="utf-8"?>
<androidx.cardview.widget.CardView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/areaRoot"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_margin="16dp"
    app:cardCornerRadius="18dp"
    app:cardElevation="8dp"
    app:cardBackgroundColor="#FFFFFF">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="14dp">

        <TextView
            android:id="@+id/areaName"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/map_area_placeholder"
            android:textColor="#3E2723"
            android:textStyle="bold"
            android:textSize="17sp" />

        <TextView
            android:id="@+id/areaKind"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/map_kind_placeholder"
            android:textColor="#8D6E63"
            android:textSize="11sp"
            android:layout_marginBottom="6dp" />

        <TextView
            android:id="@+id/areaEmpty"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/map_area_empty"
            android:textColor="#8D6E63"
            android:gravity="center"
            android:padding="20dp"
            android:visibility="gone" />

        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/areaEncounters"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:clipToPadding="false"
            android:scrollbars="vertical" />

        <TextView
            android:id="@+id/areaClose"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="end"
            android:text="@string/habitat_close"
            android:textColor="#3E2723"
            android:textStyle="bold"
            android:padding="10dp" />
    </LinearLayout>
</androidx.cardview.widget.CardView>
