<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/habitatRoot"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="#EFEBE9"
    android:fitsSystemWindows="true"
    android:padding="12dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical">

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnLocation"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="@string/habitat_location_label"
            android:textAlignment="viewStart"
            android:maxLines="1"
            android:ellipsize="end"
            app:icon="@android:drawable/arrow_down_float"
            app:iconGravity="end"
            style="@style/Widget.MaterialComponents.Button.OutlinedButton"
            app:strokeColor="#5D4037"
            android:textColor="#3E2723" />

        <!-- Sits in the dead space the weighted location button leaves next to its dropdown arrow. -->
        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnMap"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/habitat_open_map"
            android:contentDescription="@string/map_title"
            android:minWidth="0dp"
            android:insetLeft="0dp"
            android:insetRight="0dp"
            android:paddingStart="10dp"
            android:paddingEnd="10dp"
            android:textSize="18sp"
            android:layout_marginStart="4dp"
            style="@style/Widget.MaterialComponents.Button.TextButton"
            android:textColor="#8D6E63" />

        <TextView
            android:id="@+id/tvProgress"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/habitat_progress_placeholder"
            android:textColor="#3E2723"
            android:textStyle="bold"
            android:textSize="13sp"
            android:layout_marginStart="10dp" />
    </LinearLayout>

    <!-- Scrolls: pack name + three buttons overflow a phone width on their own. -->
    <HorizontalScrollView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:scrollbars="none"
        android:layout_marginTop="4dp">

    <LinearLayout
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical">

        <com.google.android.material.chip.Chip
            android:id="@+id/chipPack"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginEnd="6dp"
            android:text="@string/habitat_location_label"
            style="@style/Widget.Material3.Chip.Assist" />

        <com.google.android.material.chip.Chip
            android:id="@+id/chipUncaught"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/habitat_uncaught_only"
            android:checkable="true"
            style="@style/Widget.Material3.Chip.Filter" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnRebuildDex"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/habitat_rebuild_dex"
            style="@style/Widget.MaterialComponents.Button.TextButton"
            android:textColor="#8D6E63" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnMain"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/habitat_open_main"
            style="@style/Widget.MaterialComponents.Button.TextButton"
            android:textColor="#8D6E63" />
    </LinearLayout>
    </HorizontalScrollView>

    <HorizontalScrollView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:scrollbars="none"
        android:layout_marginTop="6dp">

        <com.google.android.material.chip.ChipGroup
            android:id="@+id/chipsMethod"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            app:singleLine="true"
            app:chipSpacingHorizontal="6dp" />
    </HorizontalScrollView>

    <HorizontalScrollView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:scrollbars="none"
        android:layout_marginTop="2dp">

        <com.google.android.material.chip.ChipGroup
            android:id="@+id/chipsTime"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            app:singleLine="true"
            app:chipSpacingHorizontal="6dp" />
    </HorizontalScrollView>

    <TextView
        android:id="@+id/tvEmpty"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="@string/habitat_empty"
        android:textColor="#8D6E63"
        android:gravity="center"
        android:padding="24dp"
        android:visibility="gone" />

    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/rvEncounters"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:layout_marginTop="6dp"
        android:clipToPadding="false"
        android:paddingBottom="16dp"
        android:scrollbars="vertical" />

    <TextView
        android:id="@+id/tvHint"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="@string/habitat_hint"
        android:textColor="#A1887F"
        android:textSize="10sp"
        android:gravity="center" />
</LinearLayout>
